# Backend
QBT_URL=https://qbt.example.com
QBT_USER=admin
QBT_PASS=change-me
# Signs login cookies. Keep it the same across deploys to stay logged in.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me
OAUTH_FORWARD_URL=https://autoplex.example.com/callback
PLEX_URL=http://plex.example.com:32400
PLEX_TOKEN=replace-with-plex-token
DOMAIN=autoplex.example.com
PATH_DISK=/sdc
DISK_BALANCER_SPARE_DISK=sde
DISK_BALANCER_POOL_DISKS=sdb,sdc,sdd
DISK_BALANCER_MIN_FREE_GB=20
DISK_BALANCER_HEAVY_MBPS=40
DISK_BALANCER_HOT_DAYS=90
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=autoplex
MYSQL_USER=autoplex
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

